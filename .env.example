# Скопируйте в .env. Файл .env не коммитится.

GATEWAY_ADDR=:8080
ADMIN_ADDR=:8081
API_ADDR=:8082
GATEWAY_URL=http://127.0.0.1:8080

# За nginx (deploy/nginx/nginx.conf) процессы слушают только localhost,
# а CLI и плагин ходят на порт nginx без :8080:
# GATEWAY_ADDR=127.0.0.1:8080
# ADMIN_ADDR=127.0.0.1:8081
# API_ADDR=127.0.0.1:8082
# GATEWAY_URL=http://127.0.0.1

DATA_FILE=data/gateway.json
WORKSPACES_DIR=data/workspaces
ENV_FILE=.env

# Токен входа в админку. Задайте свой.
ADMIN_TOKEN=change-me

# Исходящий прокси агентов. Пустое значение в админке берёт эту переменную.
# Более позднее изменение, админка или этот файл, побеждает.
OUTBOUND_PROXY=

# Ключ OpenAI для backend GPT. На сервере шлюза, не в git.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 1 — отвечать эхом, без grok и claude. Для проверки связки.
GATEWAY_ECHO=1

# Команды агентов, если GATEWAY_ECHO не равен 1.
# GROK_COMMAND=grok agent serve
# CLAUDE_COMMAND=claude agent serve

# JSON со списком MCP-серверов stdio для GPT. Пусто — только файлы и команда сессии.
# Формат: {"servers":[{"name":"memory","command":["программа","аргумент"]}]}
# MCP_CONFIG=deploy/mcp.example.json

# Общее состояние нескольких процессов. Пусто — файл DATA_FILE.
# В docker compose адрес задан внутри сети: redis://redis:6379/0.
# REDIS_URL=redis://127.0.0.1:6379/0

# docker compose. local собирает образ из deploy/Dockerfile.
# main или 0.1.0 берёт уже опубликованный образ из GHCR.
IMAGE_TAG=local
HTTP_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
