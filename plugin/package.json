{
  "name": "remote-llm-gateway",
  "displayName": "Remote LLM Gateway",
  "description": "Chat with Remote LLM Gateway. The project stays on your machine, the agent runs on the gateway, and edits come back to the editor.",
  "icon": "media/icon-light.png",
  "version": "0.1.4",
  "publisher": "alanforester",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlanForester/remote-llm-gateway.git"
  },
  "homepage": "https://github.com/AlanForester/remote-llm-gateway",
  "bugs": {
    "url": "https://github.com/AlanForester/remote-llm-gateway/issues"
  },
  "keywords": ["llm", "gateway", "grok", "claude", "cursor", "chat"],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["AI", "Chat"],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "remoteLlm.open",
        "title": "Remote LLM: открыть чат"
      },
      {
        "command": "remoteLlm.showModel",
        "title": "Remote LLM: показать назначенную модель"
      },
      {
        "command": "remoteLlm.setToken",
        "title": "Remote LLM: задать токен"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "remoteLlmSidebar",
          "title": "Remote LLM",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "remoteLlmSidebar": [
        {
          "type": "webview",
          "id": "remoteLlm.chat",
          "name": "Remote LLM"
        }
      ]
    },
    "configuration": {
      "title": "Remote LLM Gateway",
      "properties": {
        "remoteLlm.useRemoteGateway": {
          "type": "boolean",
          "default": true,
          "description": "Connect to the gateway instead of a local CLI."
        },
        "remoteLlm.gatewayUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "Gateway address, http or ws."
        }
      }
    }
  }
}
